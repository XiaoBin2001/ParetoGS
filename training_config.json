{
  "pipeline": "paretogs_full",
  "resource_limits": {
    "cpu_max_percent": 45,
    "memory_max_percent": 45,
    "memory_mode": "guard"
  },
  "data_root": "../data",
  "repeat": 1,
  "gpu_auto_select": false,
  "gpu_id": 0,
  "stop_on_error": true,
  "run_postprocess": false,
  "output_root": "output/paretogs",
